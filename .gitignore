# Dependencies
node_modules/
.npm

# Environment — .env-local (hyphen) didn't match any of the dotted patterns
# below, so it was NOT actually git-ignored despite holding live production
# secrets (Mongo URI, JWT/encryption secrets, Firebase key, Cloudinary,
# Agora, Gmail app password). Added explicitly, plus a broader .env* catch-all.
.env
.env.local
.env.*.local
.env-local
.env*

# Logs
logs/
*.log
npm-debug.log*

# Runtime
pids/
*.pid
*.seed

# Coverage & tests
coverage/
.nyc_output/

# Build
dist/
build/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Uploads (local)
uploads/tmp/
