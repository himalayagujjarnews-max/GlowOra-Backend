FROM_EMAIL=noreply@glowora.life
FROM_NAME=GlowOra

# SMTP (used by src/utils/email.js as fallback/alternative to SendGrid — currently unset,
# falls back to console-log dev mode until filled in)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Salon auto-approval (used by src/controllers/salon.controller.js) — false = admin must
# manually approve new salon signups before they go live
AUTO_APPROVE_SALONS=false

# MongoDB connection pool sizing (used by src/config/db.js)
DB_MAX_POOL=20
DB_MIN_POOL=5

# Admin seed (first admin account)
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Super Admin

# Frontend URLs (CORS)
# LOCAL DEV — switch to these when you deploy to production:
#   CUSTOMER_APP_URL=https://glowora.life
#   PARTNER_WEB_URL=https://partner.glowora.life
#   ADMIN_WEB_URL=https://admin.glowora.life
CUSTOMER_APP_URL=http://localhost:5173
PARTNER_WEB_URL=http://localhost:5174
ADMIN_WEB_URL=http://localhost:5175

