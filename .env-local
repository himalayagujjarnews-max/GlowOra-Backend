# ================================
# GlowOra.life — Environment Variables
# ⚠️ PRODUCTION CHECKLIST (do this before going live):
#   1. Rotate MONGO_URI, FIREBASE_*, CLOUDINARY_*, AGORA_*, UPSTASH_* creds below —
#      they are real values and should be treated as already compromised once shared/committed.
#   2. Replace JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / COOKIE_SECRET / ENCRYPTION_KEY
#      (currently dev placeholders) with freshly generated random values.
#   3. Change SEED_ADMIN_PASSWORD from the default before first deploy.
#   4. Fill in RAZORPAY_*, MSG91_*, SENDGRID_API_KEY, SMTP_* — currently blank, so
#      payments / SMS OTP / transactional email will not work until set.
#   5. Set NODE_ENV=production and update API_URL + CORS URLs below to real domains.
# ================================

# Server
# LOCAL DEV — switch these two lines when you deploy to production:
#   NODE_ENV=production
#   API_URL=https://api.glowora.life
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# MongoDB (Atlas cloud cluster — non-SRV, skips DNS SRV lookup)
MONGO_URI=mongodb://himalayagujjarnews_db_user:fGgACEHD93GnFZDk@ac-opzroje-shard-00-00.a9ew4oi.mongodb.net:27017,ac-opzroje-shard-00-01.a9ew4oi.mongodb.net:27017,ac-opzroje-shard-00-02.a9ew4oi.mongodb.net:27017/glowora?ssl=true&replicaSet=atlas-oudfqt-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
# Redis (optional in dev — falls back to in-memory if not running).
# Leave commented in dev (no Redis installed). In production set this to your
# managed Redis (Upstash / ElastiCache) to enable the job queue + socket adapter.
# REDIS_URL=redis://localhost:6379

# JWT — dev secrets (CHANGE these in production!)
JWT_ACCESS_SECRET=glowora_dev_access_a7f3c9e21b8d4f6a0c5e9d2b7a1f8e3c
JWT_REFRESH_SECRET=glowora_dev_refresh_e2b9d7c4a6f1830e5c9b2d7a4f6e1c8b
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Cookie
COOKIE_SECRET=glowora_dev_cookie_9c2e7b4a1f8d3e6c5b0a9d7e2f4c1b8a

# Field encryption (AES-256) — use 64 hex chars in production
ENCRYPTION_KEY=a3f7c9e21b8d4f6a0c5e9d2b7a1f8e3c4d6b9a0e5f2c8d1b7a4e6c3f9b0d2e8a

# Admin IP allowlist (comma separated; empty = allow all)
ADMIN_IP_ALLOWLIST=

# Internationalisation
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LOCALE=en
SUPPORTED_CURRENCIES=INR,USD,AED,GBP,SGD
SUPPORTED_LOCALES=en,hi,pa,ar

# OTP — Twilio Verify is checked FIRST (see src/utils/otp.js); if these three
# are blank it falls back to MSG91 below, then to console-log dev OTP.
# Get these from https://console.twilio.com (Account SID + Auth Token on the
# dashboard) and https://console.twilio.com/us1/develop/verify/services
# (create a Verify Service, copy its "Service SID" — starts with VA...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OTP (MSG91) — leave blank in dev; OTP prints to console
MSG91_API_KEY=
MSG91_SENDER_ID=GLOWORA
MSG91_TEMPLATE_ID=

# Razorpay — add your test keys to enable payments
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (image uploads) — optional in dev
CLOUDINARY_CLOUD_NAME=dnuzhdq25
CLOUDINARY_API_KEY=349729459922518
CLOUDINARY_API_SECRET=Ucb-dsA_SvIKVBLAlCyR-VxCx_w

